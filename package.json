{
  "name": "game-on-webroot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.15.4",
  "type": "module",
  "scripts": {
    "dev": "node tools/next-dev.mjs 3000 --webpack --https",
    "dev:lan": "DEV_HOST=0.0.0.0 node tools/next-dev.mjs 3000 --webpack --http",
    "dev:lan:https": "DEV_HOST=0.0.0.0 node tools/next-dev.mjs 3000 --webpack --https",
    "dev:e2e": "node tools/next-dev.mjs 3000 --webpack --http",
    "dev:turbo": "node tools/next-dev.mjs 3000 --turbopack",
    "start": "node tools/next-start.mjs 3000",
    "build": "next build --webpack",
    "build:analyze": "ANALYZE=true next build --webpack",
    "build:assets": "PRINT_BUILD_ASSETS=true next build --webpack",
    "serve": "node tools/next-start.mjs 4000",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --ui-host 127.0.0.1",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report --host 127.0.0.1",
    "prettier": "npx prettier ./src/**/*.{tsx,ts} --write"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "1.15.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.66.5",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.5.21",
    "currency-symbol-map": "^5.1.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "^1.44.0",
    "fbemitter": "^3.0.0",
    "input-otp": "^1.4.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.525.0",
    "matter-js": "^0.20.0",
    "md5": "^2.3.0",
    "mqtt": "^5.14.1",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "qr.js": "^0.0.0",
    "react": "^19.0.0",
    "react-avatar-editor": "^14.0.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.0.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-number-format": "^5.4.4",
    "react-paginate": "^8.3.0",
    "react-virtuoso": "^4.14.0",
    "sonner": "^2.0.6",
    "spin-wheel": "^5.0.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.6",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/fbemitter": "^2.0.35",
    "@types/matter-js": "^0.20.2",
    "@types/md5": "^2.3.5",
    "@types/node": "^24.0.15",
    "@types/react": "^19.0.8",
    "@types/react-avatar-editor": "^13.0.4",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "daisyui": "^5.0.50",
    "dotenv": "^17.4.2",
    "jsdom": "^26.0.0",
    "prettier-plugin-organize-imports": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
